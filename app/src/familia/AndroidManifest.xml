<?xml version="1.0" encoding="utf-8"?>
<!-- Solo en la versión familia: actualizaciones descargadas de GitHub (Play no lo permite). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para instalar las actualizaciones descargadas de GitHub -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Resultado de la instalación de actualizaciones en segundo plano -->
        <receiver
            android:name=".util.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Comparte la APK descargada con el instalador de Android -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
