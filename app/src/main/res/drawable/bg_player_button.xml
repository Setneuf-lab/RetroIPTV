<?xml version="1.0" encoding="utf-8"?>
<!-- Botones del reproductor: se iluminan en ámbar al recibir el foco del mando -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#E6E0A04A" />
            <stroke android:width="2dp" android:color="@color/amber_light" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC0D0B09" />
            <stroke android:width="1dp" android:color="#66E0A04A" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
