<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjetas grandes del menú principal -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#59E0A04A" android:endColor="#26E0A04A" />
            <stroke android:width="3dp" android:color="@color/amber_light" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/amber_dim" />
            <stroke android:width="2dp" android:color="@color/amber" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#D926221E" android:endColor="#D9141210" />
            <stroke android:width="1dp" android:color="#33F3EDE4" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
